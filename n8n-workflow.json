          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n\"masthead\": \"string\",\n\"date\": \"string\",\n\"headline\": \"string\",\n\"subheadline\": \"string\",\n\"sections\": [\n{\n\"title\": \"string\",\n\"articles\": [\n{\n\"title\": \"string\",\n\"summary\": \"string\"\n}\n]\n}\n]\n}",
        "autoFix": true
