      "id": "63e92c79-0ef4-4ba6-b8e1-59110fbbb004",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $json;\nconst ctx = $('Set Subscriber Context').first().json;\n\n// Build sections\nconst sectionsHTML = (data.sections || []).map(section => {\n\n  const articles = (section.articles || []).map(article => `\n    <div style=\"margin-bottom: 14px;\">\n      <h3 style=\"font-size: 18px; margin: 0 0 4px 0; color: #222;\">${article.title}</h3>\n      <p style=\"font-size: 15px; line-height: 1.5; color: #444; margin: 0;\">${article.summary}</p>\n    </div>\n  `).join(\"\");\n\n  return `\n    <div style=\"margin-bottom: 25px; break-inside: avoid;\">\n      <h2 style=\"font-size: 20px; border-bottom: 2px solid #222; padding-bottom: 6px; margin-bottom: 12px;\">${section.title}</h2>\n      ${articles}\n    </div>\n  `;\n\n}).join(\"\");\n\n\nconst html = `\n<div style=\"font-family: 'Times New Roman', Georgia, serif;\">\n  <div style=\"text-align: center; margin-bottom: 20px;\">\n    <h2 style=\"font-size: 32px; font-weight: bold; margin: 0;\">${data.headline || ''}</h2>\n    <p style=\"font-size: 18px; color: #555; margin-top: 8px;\">${data.subheadline || ''}</p>\n  </div>\n  ${sectionsHTML}\n</div>\n`;\n\nreturn [{ json: { html: html, subscriberEmail: ctx.subscriberEmail } }];"
      },
